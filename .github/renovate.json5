{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    // Bazzite's base image updates daily, `"automerge": true` would
    // create an audit trail for what `stable` actually maps to but
    // would make the commit history unreadable.
    {
      "enabled": false,
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "pinDigest"]
    },
  ],

  // Track motoc, which is installed from git in build_files/build.sh.
  // The annotation above MOTOC_VERSION tells Renovate to bump the tag.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["build_files/build.sh"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+MOTOC_VERSION=\"(?<currentValue>.*?)\"",
      ],
    },
  ],
}
