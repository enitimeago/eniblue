{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
    // Bazzite's base image updates daily, `"automerge": true` would
    // create an audit trail for what `stable` actually maps to but
    // would make the commit history unreadable.
    {
      "enabled": false,
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest", "pinDigest"]
    },
  ],

  // Track the tools installed from git in build_files/build.sh (motoc,
  // oscavmgr, ...). Each is pinned to a `<NAME>_VERSION="vX.Y.Z"` shell
  // variable preceded by a `# renovate:` annotation; the generalized
  // `\w+_VERSION` match keeps every such tool bumped, not just motoc.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["build_files/build.sh"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+_VERSION=\"(?<currentValue>.*?)\"",
      ],
    },
  ],
}
